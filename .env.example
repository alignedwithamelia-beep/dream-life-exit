# Browser (public): Supabase > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Netlify Functions only (secret, never commit)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SITE_URL=
RESEND_API_KEY=
INVITE_FROM=

# Email for invites and reminders (Netlify Functions only, never commit).
# Gmail: SMTP_USER is the full Gmail address, SMTP_PASS is a Google app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Dream Life Exit Hub <you@gmail.com>"

# Payments (Netlify Functions only, never commit). Stripe Dashboard > Developers.
# Use test keys (sk_test_…) until you are ready to take real payments.
STRIPE_SECRET_KEY=
# Products > your membership > the price ID (price_…). The app shows this price.
STRIPE_PRICE_ID=
# Developers > Webhooks > your endpoint > Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=
